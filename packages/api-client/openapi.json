{
  "openapi": "3.1.0",
  "info": {
    "title": "Portfolio API",
    "description": "Public API for the portfolio platform.",
    "license": {
      "name": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/analytics": {
      "get": {
        "tags": [
          "analytics"
        ],
        "summary": "First-party visitor analytics, aggregated in SQL.",
        "operationId": "analytics",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analytics/posthog": {
      "get": {
        "tags": [
          "analytics"
        ],
        "summary": "PostHog-derived stats (pageviews, uniques, top pages) queried server-side.\n204 when PostHog is not configured.",
        "operationId": "posthog_stats",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PosthogStats"
                }
              }
            }
          },
          "204": {
            "description": "PostHog not configured"
          }
        }
      }
    },
    "/api/v1/audit": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "Most recent administration audit entries (admin bearer token).",
        "operationId": "list_audit",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditEntry"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/audit/verify": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "Recompute the full hash chain; any tampered row breaks it (admin bearer).",
        "operationId": "verify_audit",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditVerification"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/contact": {
      "post": {
        "tags": [
          "contact"
        ],
        "summary": "Accept a contact-form submission for asynchronous delivery.",
        "operationId": "submit_contact",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cv": {
      "get": {
        "tags": [
          "cv"
        ],
        "summary": "Active CV versions per language, mirrored from the CV repository releases.",
        "operationId": "active_cv",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CvVersion"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/deployments": {
      "get": {
        "tags": [
          "deployments"
        ],
        "summary": "Production deployment history (GitHub Actions runs, cached server-side).",
        "operationId": "deployments",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Deployment"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Upstream unavailable and no cache",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/github": {
      "get": {
        "tags": [
          "github"
        ],
        "summary": "GitHub profile, stars, languages and contribution calendar (cached 1h).\nReturns null when the upstream is unavailable and nothing is cached,\nmatching the old frontend fetcher's contract.",
        "operationId": "github",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/components/schemas/GitHubData"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media": {
      "get": {
        "tags": [
          "media"
        ],
        "summary": "List processed media with their generated variants.",
        "operationId": "list_media",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "Restrict to one gallery category.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "include_pending",
            "in": "query",
            "description": "Include unprocessed items (requires the admin bearer token).",
            "required": false,
            "schema": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MediaItem"
                  }
                }
              }
            }
          },
          "401": {
            "description": "include_pending without admin token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media/uploads": {
      "post": {
        "tags": [
          "media"
        ],
        "summary": "Authorize a direct-to-S3 media upload (administration).",
        "operationId": "create_upload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateUploadResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Administration API disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/spotify": {
      "get": {
        "tags": [
          "spotify"
        ],
        "summary": "Current/recent playback and top artists (captcha-gated like the old\nserver action; credentials-missing and upstream failures degrade to the\ndatabase cache).",
        "operationId": "spotify",
        "parameters": [
          {
            "name": "recaptcha_token",
            "in": "query",
            "description": "reCAPTCHA v3 token for the `spotify_data` action.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpotifyData"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Build information for the running deployment.",
        "operationId": "version",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/visits": {
      "post": {
        "tags": [
          "visits"
        ],
        "summary": "Record a visit and return the total visit count.",
        "operationId": "record_visit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordVisitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitCount"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/visits/count": {
      "get": {
        "tags": [
          "visits"
        ],
        "summary": "Total number of recorded visits.",
        "operationId": "visit_count",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitCount"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe; no dependencies are checked.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Process is alive"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness probe; verifies database connectivity.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Ready to serve traffic"
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyticsResponse": {
        "type": "object",
        "required": [
          "total",
          "daily",
          "referrers",
          "browsers",
          "countries"
        ],
        "properties": {
          "browsers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KeyCount"
            }
          },
          "countries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KeyCount"
            }
          },
          "daily": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DailyCount"
            }
          },
          "referrers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KeyCount"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AuditEntry": {
        "type": "object",
        "required": [
          "id",
          "at",
          "action",
          "detail",
          "entry_hash"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "detail": {},
          "entry_hash": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AuditVerification": {
        "type": "object",
        "required": [
          "valid",
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "integer",
            "format": "int64"
          },
          "first_invalid_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "valid": {
            "type": "boolean"
          }
        }
      },
      "ContactAccepted": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier of the stored message; delivery happens asynchronously."
          }
        }
      },
      "ContactRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "message",
          "recaptcha_token"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "recaptcha_token": {
            "type": "string",
            "description": "reCAPTCHA v3 token for the `contact_form` action."
          }
        }
      },
      "ContributionDay": {
        "type": "object",
        "required": [
          "count",
          "date",
          "level"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "date": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "ContributionYear": {
        "type": "object",
        "required": [
          "year",
          "days",
          "total"
        ],
        "properties": {
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContributionDay"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "year": {
            "type": "string"
          }
        }
      },
      "CreateUploadRequest": {
        "type": "object",
        "required": [
          "filename",
          "content_type",
          "size_bytes"
        ],
        "properties": {
          "category": {
            "type": [
              "string",
              "null"
            ],
            "description": "Gallery grouping key, e.g. an album name (sanitized, lowercased)."
          },
          "content_type": {
            "type": "string",
            "description": "Must be one of image/jpeg, image/png, image/webp."
          },
          "filename": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CreateUploadResponse": {
        "type": "object",
        "required": [
          "media_id",
          "upload_url",
          "headers",
          "expires_in_seconds"
        ],
        "properties": {
          "expires_in_seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "headers": {
            "type": "object",
            "description": "Headers the client must send with the PUT exactly as given.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "media_id": {
            "type": "string",
            "format": "uuid"
          },
          "upload_url": {
            "type": "string",
            "description": "Presigned S3 PUT URL for the original object."
          }
        }
      },
      "CvVersion": {
        "type": "object",
        "required": [
          "lang",
          "release_tag",
          "sha256",
          "size_bytes",
          "updated_at"
        ],
        "properties": {
          "lang": {
            "type": "string"
          },
          "release_tag": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "updated_at": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DailyCount": {
        "type": "object",
        "required": [
          "day",
          "count"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int64"
          },
          "day": {
            "type": "string"
          }
        }
      },
      "Deployment": {
        "type": "object",
        "required": [
          "sha",
          "title",
          "started_at",
          "duration_seconds",
          "html_url"
        ],
        "properties": {
          "conclusion": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_seconds": {
            "type": "integer",
            "format": "int64"
          },
          "html_url": {
            "type": "string"
          },
          "sha": {
            "type": "string"
          },
          "started_at": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "GitHubData": {
        "type": "object",
        "description": "Mirrors the shape the frontend consumed from the old TypeScript fetcher.",
        "required": [
          "username",
          "name",
          "bio",
          "publicRepos",
          "followers",
          "following",
          "totalStars",
          "topLanguages",
          "profileUrl",
          "createdAt",
          "contributionsByYear"
        ],
        "properties": {
          "bio": {
            "type": "string"
          },
          "contributionsByYear": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContributionYear"
            }
          },
          "createdAt": {
            "type": "string"
          },
          "followers": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "following": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "profileUrl": {
            "type": "string"
          },
          "publicRepos": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "topLanguages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LanguageCount"
            }
          },
          "totalStars": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "username": {
            "type": "string"
          }
        }
      },
      "KeyCount": {
        "type": "object",
        "required": [
          "key",
          "count"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int64"
          },
          "key": {
            "type": "string"
          }
        }
      },
      "LanguageCount": {
        "type": "object",
        "required": [
          "lang",
          "count"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "lang": {
            "type": "string"
          }
        }
      },
      "MediaItem": {
        "type": "object",
        "required": [
          "id",
          "filename",
          "content_type",
          "state",
          "variants"
        ],
        "properties": {
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_type": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string"
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaVariant"
            }
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "MediaVariant": {
        "type": "object",
        "required": [
          "format",
          "key",
          "width",
          "height",
          "size_bytes"
        ],
        "properties": {
          "format": {
            "type": "string"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          },
          "key": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Absolute URL when a public media base URL is configured."
          },
          "width": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PosthogStats": {
        "type": "object",
        "required": [
          "daily_pageviews",
          "daily_uniques",
          "top_pages"
        ],
        "properties": {
          "daily_pageviews": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DailyCount"
            }
          },
          "daily_uniques": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DailyCount"
            }
          },
          "top_pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KeyCount"
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details body.",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "errors": {
            "type": [
              "object",
              "null"
            ],
            "description": "Per-field validation messages, present on validation failures only.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "RecordVisitRequest": {
        "type": "object",
        "required": [
          "recaptcha_token"
        ],
        "properties": {
          "page": {
            "type": [
              "string",
              "null"
            ],
            "description": "Page that was visited."
          },
          "recaptcha_token": {
            "type": "string",
