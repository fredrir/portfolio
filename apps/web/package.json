{
  "name": "@portfolio/web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "doppler run --preserve-env=API_URL,ADMIN_TOKEN,VITE_RECAPTCHA_SITE_KEY -- vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe .",
    "typecheck": "tsc --noEmit",
    "build:wasm": "cd ../../crates/terminal-plugins && cargo build --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/terminal_plugins.wasm ../../apps/web/public/wasm/terminal-plugins.wasm"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/roboto": "^5.2.10",
    "@formatjs/intl-localematcher": "^0.8.1",
    "@phosphor-icons/react": "^2.1.10",
    "@portfolio/api-client": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "@types/three": "^0.185.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.36.0",
    "negotiator": "^1.0.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.399.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "nitro": "^3.0.260610-beta",
    "tailwindcss": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
