{
  "name": "portfolio",
  "version": "3.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git config core.hooksPath .githooks; fi",
    "dev": "bun scripts/dev.ts",
    "dev:web": "bun run --filter @portfolio/web dev",
    "dev:api": "doppler run --preserve-env=DATABASE_URL,API_ADDR,AWS_ACCESS_KEY_ID,AWS_SECRET_ACCESS_KEY,AWS_REGION,AWS_ENDPOINT_URL,MEDIA_BUCKET,MEDIA_UPLOAD_ENDPOINT_URL,MEDIA_PUBLIC_BASE_URL,ADMIN_TOKEN,RECAPTCHA_SECRET_KEY -- cargo run -p portfolio-api",
    "dev:seed": "bun scripts/seed-dev-media.ts",
    "audit:reseal": "cargo run -p portfolio-api --bin reseal-audit",
    "build": "bun run --filter @portfolio/web build",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "^26.1.2"
  }
}
