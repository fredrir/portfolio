[Unit]
Description=Caddy reverse proxy (blue-green upstream selection)
After=network-online.target

[Container]
Image=docker.io/library/caddy:2-alpine
ContainerName=caddy
Network=portfolio.network
Volume=%h/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=%h/caddy/slots:/etc/caddy/slots:ro,Z
Volume=caddy-data:/data
Volume=caddy-config:/config
NoNewPrivileges=true
DropCapability=all
# The image's caddy binary carries the net_bind_service file capability;
# exec fails under no-new-privileges unless the cap is in the permitted set.
AddCapability=NET_BIND_SERVICE
HealthCmd=wget -q -O /dev/null http://127.0.0.1:8080/healthz
HealthInterval=10s
HealthRetries=5
PodmanArgs=--memory=256m --pids-limit=256

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
