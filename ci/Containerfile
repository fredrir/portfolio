FROM docker.io/library/rust@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3 AS rust
FROM docker.io/oven/bun@sha256:d56a2534ffd262e92c12fd3249d3924d296d97086da773f821d7d0477435ea04 AS bun
FROM docker.io/library/postgres@sha256:051f7b7b3abdd564d5d1bd1e8c4b9c1b6e77087d1dd22020ede611c096a272e0 AS rust-tests
RUN apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates git pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup PATH=/usr/local/cargo/bin:$PATH CARGO_BUILD_JOBS=2
RUN rustup component add rustfmt clippy
WORKDIR /app
COPY . .
RUN bash ci/rust.sh

FROM bun AS web-tests
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/web/package.json apps/web/package.json
COPY apps/edge/package.json apps/edge/package.json
COPY packages/api-client/package.json packages/api-client/package.json
RUN bun install --frozen-lockfile
COPY . .
RUN bun run lint && bun run --filter '@portfolio/web' typecheck && bun run --filter '@portfolio/edge' typecheck && bun run --filter '@portfolio/web' build
