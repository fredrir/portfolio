# Variable reference only — actual values live in Doppler (project: portfolio).
# Run everything through `doppler run --`; see README. Do not create a .env file.

# API + worker (dev values point at compose services)
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio
API_ADDR=127.0.0.1:8080
API_URL=http://localhost:8080

# Media pipeline (LocalStack locally; real AWS in production)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
MEDIA_BUCKET=portfolio-media-dev
MEDIA_QUEUE_URL=http://localhost:4566/000000000000/media-processing
ADMIN_TOKEN=dev-admin-token
