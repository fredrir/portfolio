# Local development configuration; copy to .env and adjust.
# Matches the Postgres service in compose.yaml.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio
API_ADDR=127.0.0.1:8080

# Web app (apps/web) — server-side secrets
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
# RECAPTCHA_SECRET_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Base URL the SSR server uses to reach the Axum API
API_URL=http://localhost:8080

# Web app — public (bundled into the client)
# VITE_RECAPTCHA_SITE_KEY=
